# Environment Variables for Student Resume Analyzer Platform

# Local SQLite Database (Default, ready out of the box)
DATABASE_URL="file:./dev.db"

# Optional Cloud Database (PostgreSQL / Supabase / Neon / AWS RDS)
# If using Supabase / Neon / PostgreSQL, change provider to 'postgresql' in prisma/schema.prisma and set:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Server Port
PORT=3000
